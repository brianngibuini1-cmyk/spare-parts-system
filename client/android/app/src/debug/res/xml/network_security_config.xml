<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG BUILDS ONLY. This file overrides src/main/res/xml/network_security_config.xml
    for the debug build type. Release and profile builds use the main file, which
    forbids all cleartext traffic.

    Cleartext is permitted only for controlled local development:
      * 10.0.2.2              - Android emulator alias for the development computer.
      * 127.0.0.1 / localhost - a USB-connected device using `adb reverse tcp:8000 tcp:8000`,
                                which tunnels the device's loopback port to the
                                development computer over USB (no LAN exposure).
    The Dart client additionally requires APP_ENV=development and
    ALLOW_INSECURE_DEV_HTTP=true (and ANDROID_ADB_REVERSE=true for loopback).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
